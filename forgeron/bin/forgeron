#!/usr/bin/env bash
# Shim so the tool is one word on the PATH, from any directory. No packaging step:
# the package is pure stdlib, so PYTHONPATH is the whole install.
set -euo pipefail
here="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
export PYTHONPATH="$here${PYTHONPATH:+:$PYTHONPATH}"
exec python3 -m forgeron "$@"
